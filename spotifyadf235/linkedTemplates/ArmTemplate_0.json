			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Jsonwatermark__sink_DS')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage_spotify_DS",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_sinkfilename": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_sinkfilename",
							"type": "Expression"
						},
						"folderPath": "cdc",
						"fileSystem": "bronze"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage_spotify_DS')]"
			]

				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "empty.json",
						"folderPath": "cdc",
						"fileSystem": "bronze"
					}
				},
				"schema": {}

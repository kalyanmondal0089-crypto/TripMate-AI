						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": "cdc",
						"fileSystem": "bronze"
					}
				},
				"schema": {}
			},
			"dependsOn": [

{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "spotifyadf235"
		},
		"AzureDataLakeStorage_spotify_DS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_spotify_DS'"
		},
		"AzureSqlDatabase_spotify_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_spotify_LS'"
		},
		"AzureDataLakeStorage_spotify_DS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagekalyan56.dfs.core.windows.net/"
		},
		"AzureSqlDatabase_spotify_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyserver23.database.windows.net"
		},
		"AzureSqlDatabase_spotify_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotify23"
		},
		"AzureSqlDatabase_spotify_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin_kalyan"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataLakeStorage_spotify_DS')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('AzureDataLakeStorage_spotify_DS_properties_typeProperties_url')]",

			}
		],
		"variables": {
			"tables_names": {
				"type": "String"
			},
			"date_col": {
				"type": "String"
			},
			"filename": {
				"type": "String"
			},
			"cdc_date": {
				"type": "String"
			},
			"maximum_date": {
				"type": "String"
			}
		},
		"annotations": []
	}
